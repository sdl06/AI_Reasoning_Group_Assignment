    "stockfish",
    "chess.engine",
    "catanatron.players",
    "catanatron_experimental",
    "subprocess",
    "socket",
    "requests",
    "urllib.request",
    "http.client",
    "httpx",
    "aiohttp"
  ],
  "road_trip": {
